.DS_Store

# SwiftPM build artifacts
Loqui/.build/
Loqui/.swiftpm/

# Release artifacts
dist/

# Generated app bundle. Matched by shape rather than by name so a
# CFBundleName change cannot leave the bundle tracked.
*.app/

# Xcode workspace state from opening Loqui/Package.swift
*.xcodeproj/
xcuserdata/

# Machine-specific signing settings; never tracked
/Local.xcconfig

# Downloaded Parakeet models
models/

# Python fixture bytecode
__pycache__/
